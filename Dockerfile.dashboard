FROM python:3.11-slim
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ROOT=/app

COPY pyproject.toml .
COPY src/ ./src/

RUN pip install --upgrade pip \
 && pip install --no-cache-dir .

# Bake models + processed data into the image so reads are native Linux I/O,
# not Windows bind-mount I/O (which is 10-100x slower via VirtioFS).
COPY models/ ./models/
COPY data/processed/ ./data/processed/

EXPOSE 8501

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c \
  "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"

CMD ["streamlit", "run", \
     "src/role_recommender/dashboard/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.enableCORS=false", \
     "--server.enableXsrfProtection=false"]
