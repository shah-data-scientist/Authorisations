# Copy this file to .env and fill in values.
# .env is git-ignored — never commit secrets.

# PostgreSQL password (used by db, migrate, api services)
POSTGRES_PASSWORD=changeme

# The DATABASE_URL and REDIS_URL are auto-constructed in docker-compose.yml
# from POSTGRES_PASSWORD. Only set these manually to override the defaults.
# DATABASE_URL=postgresql+asyncpg://accessmgmt:changeme@db:5432/accessmgmt
# REDIS_URL=redis://redis:6379/0
